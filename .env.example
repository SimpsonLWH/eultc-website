# MongoDB connection string, used by the app and `npm run db:seed`.
# Production: a managed MongoDB Atlas cluster. Local: any MongoDB instance,
# for example a local mongod on mongodb://localhost:27017/dev.
# Copy this file to .env.local and fill it in. Never commit .env.local.
MONGODB_URI=mongodb://localhost:27017/dev

# Better Auth signing secret (required). Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public application URL used to build auth callbacks and invite links.
BETTER_AUTH_URL=http://localhost:3000

# Optional on Vercel Preview deployments: enable the credentials dev login.
# Local development enables it automatically; Production never accepts it.
# AUTH_DEV_LOGIN=true

# Optional local/preview password for the seeded quick-login accounts.
# AUTH_DEV_PASSWORD=eultc-dev-password
