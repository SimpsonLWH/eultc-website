# MongoDB connection string, used by the app and `npm run db:seed`.
# Production: a managed MongoDB Atlas cluster. Local: any MongoDB instance,
# for example a local mongod on mongodb://localhost:27017/club_db.
# Copy this file to .env.local and fill it in. Never commit .env.local.
MONGODB_URI=mongodb://localhost:27017/club_db
# Used by Auth.js to sign and encrypt session cookies; replace with a random secret.
AUTH_SECRET=replace-with-a-random-secret
# Credentials login is automatic outside production; set true only for an intentional production opt-in.
AUTH_DEV_LOGIN=false
