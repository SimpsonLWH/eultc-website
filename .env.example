# MongoDB connection string, used by the app and `npm run db:seed`.
# Production: a managed MongoDB Atlas cluster. Local: any MongoDB instance,
# for example a local mongod on mongodb://localhost:27017/dev.
# Copy this file to .env.local and fill it in. Never commit .env.local.
MONGODB_URI=mongodb://localhost:27017/dev

# Auth.js signing secret (required). Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: force the credentials dev login on even in a production build.
# AUTH_DEV_LOGIN=true
